# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456789:AAExampleTokenHere

# Admin panelga kirish uchun login/parol
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kuchli-parol-qoying

# (ixtiyoriy) PostgreSQL bazasi - Railway'da PostgreSQL qo'shsangiz
# avtomatik beriladi. Bo'sh qoldirilsa, bot lokal SQLite fayliga
# (data/bot_data.db) yozadi.
DATABASE_URL=

# (ixtiyoriy) Admin panel porti - Railway buni avtomatik $PORT orqali beradi
ADMIN_PORT=8000

# (ixtiyoriy) Ma'lumot fayllari joylashgan papka
DATA_DIR=./data

# (ixtiyoriy) Bo'sh xonalarni avtomatik skanerlash sozlamalari
ROOM_SCAN_START=1
ROOM_SCAN_END=640
ROOM_SCAN_INTERVAL_DAYS=7

# (ixtiyoriy) OpenAI integratsiyasi - foydalanuvchi erkin matn yozganda
# ("AT-75 guruh jadvalini topib ber", "dushanba kuniga bo'sh xona
# kerak" va h.k.) buni avtomatik bot buyrug'iga aylantirish uchun.
# Bo'sh qoldirilsa, bu funksiya butunlay o'chirilgan holatda ishlaydi -
# botning oldingi xatti-harakati o'zgarmaydi.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
